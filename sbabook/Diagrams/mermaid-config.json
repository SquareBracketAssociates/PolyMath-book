{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Helvetica, Arial, sans-serif",
    "fontSize": "14px",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#000000",
    "mainBkg": "#ffffff",
    "nodeBorder": "#000000",
    "lineColor": "#000000",
    "textColor": "#000000",
    "edgeLabelBackground": "#ffffff"
  },
  "themeCSS": "code{font-size:13px;font-family:Menlo,Monaco,monospace;} .node rect,.node polygon,.node path{filter:none !important;}",
  "class": {
    "hideEmptyMembersBox": false
  },
  "flowchart": {
    "wrappingWidth": 260,
    "curve": "step",
    "nodeSpacing": 30,
    "rankSpacing": 25,
    "padding": 8,
    "diagramPadding": 4
  }
}
